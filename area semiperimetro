#include <iostream>
#include <math.h>
using namespace std;
int main()
{
    float area,s,lado1,lado2,lado3;
    cout<<"ingresar lado1: "<<endl;
    cin>>lado1;
    cout<<"ingresar lado2: "<<endl;
    cin>>lado2;
    cout<<"ingresar lado3: "<<endl;
    cin>>lado3;
    s=(lado1+lado2+lado3)/2;
    area = sqrt (s*(s-lado1)*(s-lado2)*(s-lado3));
    cout<<"El semiperimetro es: "<<area;
    return 0;
}
