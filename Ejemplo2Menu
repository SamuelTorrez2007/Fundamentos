#include <iostream>
#include <cstdlib> // Para system("pause") y system("cls")

using namespace std;

// Prototipos de funciones
float cubo(float n);
int calcularmenor(int a, int b);
int signo(float a);

int main() {
    float f;
    int opcion, x, a, b;

    do {
        // Desplegar las opciones
        cout << "\t\t Menu \n";
        cout << "\t\t ==== \n";
        cout << "1. Calcular el cubo \n";
        cout << "2. El menor de dos numeros enteros \n";
        cout << "3. El signo de un numero \n";
        cout << "0. Salir\n";
        cout << "Opcion: ";
        cin >> opcion;

        switch (opcion) {
        case 1: {
            float numF;
            cout << "Ingresar numero: ";
            cin >> numF;
            float resultadoCubo = cubo(numF);
            cout << "El resultado es: " << resultadoCubo << endl;
            break;
        }
        case 2: {
            cout << "Ingrese el primer numero: ";
            cin >> a;
            cout << "Ingrese el segundo numero: ";
            cin >> b;
            int menor = calcularmenor(a, b);
            cout << "El menor es: " << menor << endl;
            break;
        }
        case 3:
            cout << "Ingrese un numero: ";
            cin >> f;
            x = signo(f);
            cout << "El resultado es (1: positivo, -1: negativo, 0: cero): " << x << endl;
            break;
        case 0:
            cout << "Saliendo del Menu\n";
            break;
        default:
            cout << "ERROR de opcion\n";
            break;
        }

        if (opcion != 0) {
            system("pause");
            system("cls");
        }

    } while (opcion != 0);

    return 0;
}
float cubo(float n) {
    return n * n * n;
}

int calcularmenor(int a, int b) {
    if (a < b)
        return a;
    else
        return b;
}

int signo(float a) {
    if (a > 0) return 1;
    if (a < 0) return -1;
    return 0;
}
