#include <iostream> 
#include <cmath>
using namespace std;

int main()
{
    int n;
    cout<<"Ingrese un número entero: ";
    cin>>n;
    
    bool esPrimo=true;
    
    if(n<=1) {
        esPrimo=false;
    }else {
        for (int i=2; i<=sqrt(n);i++){
            if (n%i==0) {
                esPrimo=false;
                break;
            }
        }
    }
    if(esPrimo) {
        cout<<n<<" es un número primo."<<endl;
    } else {
        cout<<n<<" no es número primo."<<endl;
    }

    return 0;
}
