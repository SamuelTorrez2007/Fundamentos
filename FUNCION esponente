







#include <iostream>
using namespace std;

int potencia(int base, int exponente);

int main(){
    int base, exponente;
    cout<<"Ingrese la base: ";
    cin>>base;
    cout<<"Ingrerse el exponente: ";
    cin>>exponente;
    if (exponente<0){
        cout<<"Error, solo se aceptan exponentes positivos";
        return 0;
    }
    double resultado=potencia(base,exponente);
    
    cout<<base<<" Elevado a la "<<exponente<<" Es: "<<resultado;
    return 0;
}
int potencia(int base, int exponente){
    int resultado=1;
    for (int i=0; i<exponente; i++){
        resultado=resultado*base;
    }
    return resultado;
}



    
    
    
