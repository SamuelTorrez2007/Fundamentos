#include <iostream>
#include <string>
#include <iomanip>

using namespace std;

int main() {
	string nombre;
	double horasTrabajadas, pagoPorHora, porcentajeBono;
	int diasTarde;

	cout << "==SISTEMAS DE CÁLCULO DE SALARIOS ===" << endl;
	cout << "Ingrese el nombre del empleado: ";
	getline(cin, nombre);

	cout << "Ingrese las horas trabajadas en el mes: ";
	cin >> horasTrabajadas;

	cout << "Ingrese el pago por hora: ";
	cin >> pagoPorHora;

	cout << "Ingrese el numero de dias que llego tarde: ";
	cin >> diasTarde;

	cout << "Ingrese el porcentaje de bonificacion apicable (ej. 10 para 10%): ";
	cin >> porcentajeBono;

	double salarioBruto = horasTrabajadas * pagoPorHora;

	double penalizacion = 0.0;
	if (diasTarde > 3) {
		penalizacion = salarioBruto * 0.05;
	}

	double bono = salarioBruto * (porcentajeBono / 100.0);

	double salarioNeto = salarioBruto + bono - penalizacion;

	cout << "\n--------------------------------------" << endl;
	cout << "RESUMEN DE PAGO" << endl;
	cout << "---------------------------------------" << endl;
	cout << fixed << setprecision(2);
	cout << "Empleado:            " << nombre << endl;
	cout << "Salario Bruto:        $" << salarioBruto << endl;
	cout << "Penalizacion (5%):    $" << penalizacion << endl;
	cout << "Bono:                 $" << bono << endl;
	cout << "Salario Neto Final:   $" << salarioNeto << endl;
	cout << "----------------------------------------" << endl;

	return 0;
}


    
