#include <iostream>
#define MAX 100
 
using namespace std;
void cargar(int vec[], int n);
void mostrar(int vec[], int n);
void burbuja(int vec[], int m);

void main() {
	float b, a, d, f, Fac;
	int opcion;
	// Menu
	do {
		//Desplegar las opciones
		cout << "\t\t Menu \n";
		cout << "\t\t ==== \n";
		cout << "1. Cargar\n";
		cout << "2. Mostrar\n";
		cout << "3. Clasificar\n";
		cout << "0. Salir\n";
		cout << "Opcion: ";
		cin >> opcion;
		// Condicional multiple
		switch (opcion)
		{
		case 1: cout << "Ingresar el tamaño del primer vector:";
			cin >> f;
			Fac = cargar(f);
			cout << "El factorial es: " << Fac;
			break;
		case 2: cout << "Ingresar el tamaño del segundo vector:";
			cin >> a;
			Fac = mostrar(a);
			cout << "La raiz es: " << raiz(a);
			break;
		case 3: cout << "Ingrese la base: ";
			cin >> b;
			cout << "Ingrese la altura: ";
			cin >> a;
			cout << "El area es: " << area(b, a);
			break;
		case 0: cout << "Saliendo del Menu";
			break;
		default: cout << "ERROR de opcion";
			break;
		}
		getch();
		system("cls");
	} while (opcion != 0);
	getch();

}

   
}
void cargar(int vec[], int n)
{
	for (int i = 0; i < n; i++)
	{
		cout << "Vector[" << i << "]= ";
		cin >> vec[i];
	}
}

void mostrar(int vec[], int n)
{
	for (int i = 0; i < n; i++)
		cout << "Vector[" << i << "]= " << vec[i] << endl;
}

void burbuja(int vec[], int m)
{
	int aux;
	for (int i = 0; i < m - 1; i++)
	{
		for (int j = i + 1; j < m; j++)
			if (vec[i] > vec[j])
			{
				aux = vec[j];
				vec[j] = vec[i];
				vec[i] = aux;
			}
	}
}


